# Book / source material — never commit
offline_resources/

# Exported user data — never commit
*.export.json
exports/

# Dependencies & build
node_modules/
dist/
dist-ssr/
coverage/
*.local

# Editor & OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Tool-specific runtime config. Regenerate with .agents/scripts/sync-agents.sh
# The portable equivalents are `npm run dev` and vite.config.ts `server.port`.
.claude/

# Build output
dist/

# TypeScript incremental build info
*.tsbuildinfo
